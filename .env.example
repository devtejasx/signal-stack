# Copy to .env and adjust. Every option has a working default.

# --- Storage -----------------------------------------------------------------
SIGNALSTACK_DB=data/signalstack.db

# --- AI (free / free-tier / local only) ----------------------------------------
# auto = first available of: groq -> gemini -> openrouter -> ollama -> pollinations -> rule-based
LLM_PROVIDER=auto
# Local open-source model via Ollama (https://ollama.com) - used for the demo:
OLLAMA_URL=            # e.g. http://localhost:11434 to use a local model
OLLAMA_MODEL=qwen2.5:3b   # use qwen2.5:7b if you have >= 8 GB free RAM
# Optional free-tier keys (no credit card): https://console.groq.com , https://aistudio.google.com
GROQ_API_KEY=            # free, no card: https://console.groq.com/keys  (recommended)
# GROQ_MODELS=openai/gpt-oss-120b,llama-3.3-70b-versatile,...   # fallback chain, see config.py
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Keyless public endpoint (1 reply / 45 s, ~800 tokens). Last-resort fallback.
POLLINATIONS_ENABLED=1

# --- Optional official-API credentials for access-restricted sources ------------
# Reddit forbids anonymous crawling; with free API credentials subreddit sources become active.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# --- Optional e-mail delivery of the Monday brief (otherwise saved to data/outbox) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Behaviour ---------------------------------------------------------------
AUTO_APPROVE_THRESHOLD=0.55
ENABLE_SCHEDULER=1
SIGNALSTACK_HOST_DELAY=2.0
